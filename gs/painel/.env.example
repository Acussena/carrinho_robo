# Copie para .env (não vai para o GitHub) e cole a chave gratuita do Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# opcional: modelo (padrão gemini-3.5-flash, com reservas automáticas se ele estiver indisponível)
GEMINI_MODEL=
# opcional: nome do local patrulhado, aparece nos alertas e no relatório
LOCAL_PATRULHA=Calçada de teste - FIAP
